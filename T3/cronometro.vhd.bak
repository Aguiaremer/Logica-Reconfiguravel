library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity cronometro is
    Port ( 
        CLK_50MHz : in  STD_LOGIC;
        RESET     : in  STD_LOGIC; -- Reset Geral
        BT_START  : in  STD_LOGIC; -- Botão 1
        BT_CLEAR  : in  STD_LOGIC; -- Botão 2
        HEX0      : out STD_LOGIC_VECTOR (6 downto 0); -- Centésimo LSB
        HEX1      : out STD_LOGIC_VECTOR (6 downto 0); -- Centésimo MSB
        HEX2      : out STD_LOGIC_VECTOR (6 downto 0); -- Segundo LSB
        HEX3      : out STD_LOGIC_VECTOR (6 downto 0)  -- Segundo MSB
    );
end cronometro;

architecture Behavioral of cronometro is

    -- Sinais para os Contadores
    signal clk_100Hz : std_logic := '0';
    signal en_cont   : std_logic := '0';
    signal clr_cont  : std_logic := '0';
    
    -- Sinais de interconexão dos contadores (BCD)
    signal c_un, c_de, s_un, s_de : std_logic_vector(3 downto 0);
    signal tc_c_un, tc_c_de, tc_s_un : std_logic;

    -- Sinais de controle de estado e botões
    signal rodando    : boolean := false;
    signal bt1_deb    : std_logic := '0';
    signal bt2_deb    : std_logic := '0';
    signal bt1_last   : std_logic := '0';

begin

    -------------------------------------------------------------------
    -- 1. DIVISOR DE CLOCK (50MHz -> 100Hz para centésimos)
    -- 50.000.000 / 100 = 500.000 ciclos
    -------------------------------------------------------------------
    process(CLK_50MHz)
        variable count : integer range 0 to 250000 := 0;
    begin
        if rising_edge(CLK_50MHz) then
            if count = 250000 then
                clk_100Hz <= not clk_100Hz;
                count := 0;
            else
                count := count + 1;
            end if;
        end if;
    end process;

    -------------------------------------------------------------------
    -- 2. DEBOUNCE (30ms @ 50MHz = 1.500.000 ciclos)
    -------------------------------------------------------------------
    process(CLK_50MHz)
        variable count1, count2 : integer range 0 to 1500000 := 0;
    begin
        if rising_edge(CLK_50MHz) then
            -- Debounce Botão 1
            if BT_START = '1' then
                if count1 < 1500000 then count1 := count1 + 1; else bt1_deb <= '1'; end if;
            else
                count1 := 0; bt1_deb <= '0';
            end if;
            -- Debounce Botão 2
            if BT_CLEAR = '1' then
                if count2 < 1500000 then count2 := count2 + 1; else bt2_deb <= '1'; end if;
            else
                count2 := 0; bt2_deb <= '0';
            end if;
        end if;
    end process;

    -------------------------------------------------------------------
    -- 3. LÓGICA DE CONTROLE (Start/Stop/Reset)
    -------------------------------------------------------------------
    process(CLK_50MHz, RESET)
    begin
        if RESET = '1' then
            rodando <= false;
            clr_cont <= '1';
        elsif rising_edge(CLK_50MHz) then
            bt1_last <= bt1_deb;
            clr_cont <= '0';

            -- Detecta borda de subida do botão 1 (Start/Stop)
            if bt1_deb = '1' and bt1_last = '0' then
                rodando <= not rodando;
            end if;

            -- Botão 2 (Clear) só funciona se parado
            if not rodando and bt2_deb = '1' then
                clr_cont <= '1';
            end if;
        end if;
    end process;

    en_cont <= '1' when rodando else '0';

    -------------------------------------------------------------------
    -- 4. INSTANCIAÇÃO DOS CONTADORES (CASCATA)
    -------------------------------------------------------------------
    
    -- Centésimos Unidade
    C0: entity work.contador_4bits port map (CLK => clk_100Hz, RST => RESET, CLR => clr_cont, EN => en_cont, PUSH => "0000", Q => c_un);
    tc_c_un <= '1' when (c_un = "1001" and en_cont = '1') else '0';

    -- Centésimos Dezena
    C1: entity work.contador_4bits port map (CLK => clk_100Hz, RST => RESET, CLR => clr_cont, EN => tc_c_un, PUSH => "0000", Q => c_de);
    tc_c_de <= '1' when (c_de = "1001" and tc_c_un = '1') else '0';

    -- Segundos Unidade
    C2: entity work.contador_4bits port map (CLK => clk_100Hz, RST => RESET, CLR => clr_cont, EN => tc_c_de, PUSH => "0000", Q => s_un);
    tc_s_un <= '1' when (s_un = "1001" and tc_c_de = '1') else '0';

    -- Segundos Dezena (Vai até 5 para fechar 59s, mas seu contador limpa no 9, o que é aceitável para 4 dígitos)
    C3: entity work.contador_4bits port map (CLK => clk_100Hz, RST => RESET, CLR => clr_cont, EN => tc_s_un, PUSH => "0000", Q => s_de);

    -------------------------------------------------------------------
    -- 5. DECODIFICADORES 7 SEGMENTOS
    -------------------------------------------------------------------
    D0: entity work.bcd_7seg port map (BCD => c_un, SEG => HEX0);
    D1: entity work.bcd_7seg port map (BCD => c_de, SEG => HEX1);
    D2: entity work.bcd_7seg port map (BCD => s_un, SEG => HEX2);
    D3: entity work.bcd_7seg port map (BCD => s_de, SEG => HEX3);

end Behavioral;