library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity totalizador_a_tb is
end;

architecture sim of totalizador_a_tb is

    signal clk   : std_logic := '0';
    signal rst   : std_logic := '1';
    signal din   : std_logic_vector(4 downto 0);
    signal count : unsigned(2 downto 0);

begin

uut: entity work.totalizador_serial
    port map(clk, rst, din, count);

clk <= not clk after 10 ns;

process
begin
    wait for 20 ns;
    rst <= '0';

    -- precisa esperar 5 clocks por palavra!
    din <= "10101"; wait for 120 ns; -- 3
    din <= "11111"; wait for 120 ns; -- 5
    din <= "00001"; wait for 120 ns; -- 1

    wait;
end process;

end;