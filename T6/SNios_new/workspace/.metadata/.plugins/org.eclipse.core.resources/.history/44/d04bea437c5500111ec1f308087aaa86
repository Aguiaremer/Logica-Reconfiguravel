#include <stdio.h>
#include <string.h>
#include "system.h"
#include "io.h"

// Ajustado para bater exatamente com o sinal ADD (2 bits) do seu VHDL
#define REG_ADD      0  // ADD = "00"
#define REG_DATA     1  // ADD = "01"
#define REG_CTRL     2  // ADD = "10"
#define REG_STAT     3  // ADD = "11" (Registrador de status/handshake)

#define WE_MEM       0x01 // Bit 0 ativa a escrita da BRAM no VHDL

void hw_write_byte(unsigned int addr, unsigned char data) {
    IOWR_32DIRECT(TOP_AVALON_0_BASE, REG_ADD, addr);
    IOWR_32DIRECT(TOP_AVALON_0_BASE, REG_DATA, (unsigned int)data);
    IOWR_32DIRECT(TOP_AVALON_0_BASE, REG_CTRL, WE_MEM);
}

unsigned char hw_read_byte(unsigned int addr) {
    IOWR_32DIRECT(TOP_AVALON_0_BASE, REG_ADD, addr);
    // No seu Avalon VHDL, a leitura é direta pelo endereço de dados (REG_DATA)
    return (unsigned char)IORD_32DIRECT(TOP_AVALON_0_BASE, REG_DATA);
}

int main()
{
    const char nome_str[] = " +++--+++ EMERSON FELIPE DA COSTA AGUIAR +++--+++ ";
    int str_len = strlen(nome_str);

    unsigned char seq_num = 1;
    unsigned int sw_sum = 0;
    unsigned char sw_checksum = 0;
    unsigned int pacote_validacao = 0;
    unsigned int resposta_hw = 0;
    int i;

    printf("\n--- START ----\n");

    // 1. Escrita dos caracteres e calculo do Checksum do Software
    for (i = 0; i < str_len; i++) {
        unsigned char b = (unsigned char)nome_str[i];
        hw_write_byte(i, b);
        sw_sum += b;
    }
    sw_checksum = (unsigned char)(sw_sum & 0xFF);

    // 2. Handshake (Envia para o endereço "11" / REG_STAT)
    // Coloca Seq nos bits [15:8] e Checksum nos bits [7:0] para casar com o VHDL
    pacote_validacao = (seq_num << 8) | sw_checksum;
    IOWR_32DIRECT(TOP_AVALON_0_BASE, REG_STAT, pacote_validacao);

    // 3. Polling: Aguarda o Hardware validar o match no Bit 0
    do {
        resposta_hw = IORD_32DIRECT(TOP_AVALON_0_BASE, REG_STAT);
    } while ((resposta_hw & 0x01) == 0);

    // Exibe os resultados na UART
    printf("SEQ: %d | SW_CHK: 0x%02X | MATCH: SUCESSO\n", seq_num, sw_checksum);

    // 4. Leituras consecutivas para gerar as ondas no ModelSim
    for (i = 0; i < str_len; i++) {
        hw_read_byte(i);
    }

    printf("--- END ---\n");
    while(1);
    return 0;
}
