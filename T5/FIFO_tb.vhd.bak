library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity FIFO_tb is
end FIFO_tb;

architecture behavior of FIFO_tb is

    -- Sinais de interface
    signal clock   : std_logic := '0';
    signal data    : std_logic_vector(7 downto 0) := (others => '0');
    signal rdreq   : std_logic := '0';
    signal wrreq   : std_logic := '0';
    signal empty   : std_logic;
    signal full    : std_logic;
    signal q       : std_logic_vector(7 downto 0);
    signal usedw   : std_logic_vector(9 downto 0);

    constant clk_period : time := 20 ns;

begin

    -- Instância do FIFO
    uut: entity work.FIFO
        port map (
            clock => clock,
            data  => data,
            rdreq => rdreq,
            wrreq => wrreq,
            empty => empty,
            full  => full,
            q     => q,
            usedw => usedw
        );

    -- Gerador de Clock
    clk_process : process
    begin
        clock <= '0';
        wait for clk_period/2;
        clock <= '1';
        wait for clk_period/2;
    end process;

    -- Processo de Estímulo
    stim_proc: process
    begin		
        -- Reset / Inicialização
        wrreq <= '0';
        rdreq <= '0';
        data <= (others => '0');
        wait for clk_period * 5;

        -- 1. ESCRITA: Inserir 5 valores sequenciais
        wait until falling_edge(clock);
        for i in 1 to 5 loop
            wrreq <= '1';
            data <= std_logic_vector(to_unsigned(i * 10, 8)); -- Valores: 10, 20, 30...
            wait for clk_period;
        end loop;
        wrreq <= '0';

        wait for clk_period * 2;

        -- 2. LEITURA: Ler os valores inseridos
        -- Observe que 'q' só muda no ciclo seguinte ao rdreq
        wait until falling_edge(clock);
        for i in 1 to 5 loop
            rdreq <= '1';
            wait for clk_period;
        end loop;
        rdreq <= '0';

        wait for clk_period * 5;

        -- 3. TESTE DE STATUS: Encher o FIFO (Opcional - demora 1024 ciclos)
        -- Aqui você veria o sinal 'full' subindo e 'usedw' chegando em 1024
        
        wait;
    end process;

end behavior;